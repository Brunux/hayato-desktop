/* LazyOS theme: Everforest Dark (everforest) - generated by `lazyos theme set`; do not edit.
   Change the theme (`lazyos theme set NAME`) or the template, then set it again. */
/* The games library and the HTML games: the active palette as CSS variables.
 *
 * The library page and every web game read these names, so a theme switch
 * repaints the grid and the games that use the palette without either of them
 * knowing which theme is active. The values are the same roles the GTK4 file
 * next door uses, so a game window and a document window are the same colours.
 *
 * This file is generated; edit the template in
 * rust/crates/lazyos-theme/templates/games.css.tpl, not this file.
 */
:root {
  --bg: #2d353b;
  --surface: #343f44;
  --surface-alt: #7a8478;
  --border: #a7c080;
  --faint: #6f6f67;
  --dim: #8d897b;
  --text: #d3c6aa;
  --strong: #d3c6aa;
  --accent: #a7c080;
  --accent-alt: #7fbbb3;
  --ok: #a7c080;
  --warn: #dbbc7f;
  --danger: #e67e80;
  --info: #7fbbb3;
  --selection: #3d484d;
}
