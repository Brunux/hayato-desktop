   Change the theme (`hayato theme set NAME`) or the template, then set it again. */
/* Hayato Filer: minimalistic Finder / elementary OS Files layout with Hayato
 * Cyber-HUD geometry and live theme tokens.
 *
 * This file is generated; edit rust/crates/hayato-theme/templates/filer.css.tpl.
 */

window.hayato-filer {
    background-color: #eff1f5;
    color: #4c4f69;
    font-size: 13px;
}

/* ── Top Header & Breadcrumbs ────────────────────────────────────────────── */
.filer-header {
    background-color: #e6e9ef;
    border-bottom: 1px solid #1e66f5;
    padding: 4px 8px;
    min-height: 36px;
}

.filer-nav-btn,
.filer-tool-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #4c4f69;
    padding: 4px 8px;
    min-height: 24px;
    min-width: 24px;
    box-shadow: none;
}

.filer-nav-btn:hover,
.filer-tool-btn:hover {
    background-color: #6c6f85;
    border-color: #1e66f5;
}

.filer-nav-btn:disabled {
    color: #aeb0bd;
}

.filer-tool-btn.active {
    background-color: #ccd0da;
    border-color: #1e66f5;
    color: #bcc0cc;
}

.filer-breadcrumbs {
    background-color: #eff1f5;
    border: 1px solid #1e66f5;
    border-radius: 5px;
    padding: 2px 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

.filer-crumb {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #9093a4;
    padding: 2px 6px;
    min-height: 20px;
    box-shadow: none;
}

.filer-crumb:hover {
    background-color: #6c6f85;
    color: #bcc0cc;
}

.filer-crumb.current {
    color: #bcc0cc;
    font-weight: 700;
}

.filer-crumb-sep {
    color: #aeb0bd;
    padding: 0 2px;
}

.filer-path-entry,
.filer-filter-entry {
    background-color: #eff1f5;
    color: #bcc0cc;
    border: 1px solid #1e66f5;
    border-radius: 5px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    min-height: 24px;
}

/* ── Left Sidebar (Places & Devices) ─────────────────────────────────────── */
.filer-sidebar {
    background-color: #e6e9ef;
    border-right: 1px solid #1e66f5;
    padding: 8px 6px;
}

.filer-section-label {
    color: #9093a4;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 8px 4px 8px;
}

.filer-place-row {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px 8px;
    margin: 1px 0;
    color: #4c4f69;
}

.filer-place-row:hover {
    background-color: #6c6f85;
}

.filer-place-row.active {
    background-color: #ccd0da;
    border-left: 2px solid #1e66f5;
    color: #bcc0cc;
    font-weight: 600;
}

.filer-badge {
    background-color: #6c6f85;
    color: #9093a4;
    border-radius: 8px;
    padding: 1px 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
}

.filer-dev-action {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #9093a4;
    padding: 1px 5px;
    min-height: 18px;
    min-width: 18px;
    box-shadow: none;
}

.filer-dev-action:hover {
    background-color: #eff1f5;
    border-color: #1e66f5;
    color: #1e66f5;
}

.filer-usage-bar trough {
    background-color: #eff1f5;
    border-radius: 2px;
    min-height: 3px;
}

.filer-usage-bar progress {
    background-color: #1e66f5;
    border-radius: 2px;
    min-height: 3px;
}

/* ── Main Canvas (Grid & List Views) ─────────────────────────────────────── */
.filer-canvas {
    background-color: #eff1f5;
    color: #4c4f69;
}

.filer-grid-item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 6px;
    margin: 3px;
}

.filer-grid-item:hover {
    background-color: #e6e9ef;
    border-color: #1e66f5;
}

.filer-grid-item.selected {
    background-color: #ccd0da;
    border-color: #1e66f5;
}

.filer-list-row {
    background: transparent;
    border-left: 2px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 1px 4px;
}

.filer-list-row:hover {
    background-color: #e6e9ef;
}

.filer-list-row.selected {
    background-color: #ccd0da;
    border-left-color: #1e66f5;
}

.filer-item-name {
    color: #4c4f69;
}

.filer-item-name.dir {
    color: #bcc0cc;
    font-weight: 600;
}

.filer-item-meta {
    color: #9093a4;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

/* ── Drag & Drop Highlighting ────────────────────────────────────────────── */
.drop-hover {
    background-color: #ccd0da;
    border: 1px dashed #1e66f5;
    border-radius: 6px;
}

.drop-hover-trash {
    background-color: #6c6f85;
    border: 1px dashed #996220;
    border-radius: 6px;
}

/* ── Quick Look Overlay & Banners ────────────────────────────────────────── */
.filer-quicklook {
    background-color: #e6e9ef;
    border: 1px solid #1e66f5;
    border-radius: 8px;
    padding: 14px;
}

.filer-quicklook-title {
    color: #bcc0cc;
    font-weight: 700;
    font-size: 14px;
}

.filer-quicklook-text {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    border: 1px solid #1e66f5;
    border-radius: 4px;
    padding: 8px;
}

.filer-banner {
    background-color: #6c6f85;
    border-bottom: 1px solid #1e66f5;
    padding: 5px 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

.filer-banner.warn {
    color: #996220;
}

.filer-banner.danger {
    color: #d20f39;
}

.filer-banner.ok {
    color: #2d7a1e;
}

/* ── Bottom Monospace HUD Status Bar ─────────────────────────────────────── */
.filer-statusbar {
    background-color: #e6e9ef;
    border-top: 1px solid #1e66f5;
    padding: 3px 10px;
    min-height: 24px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #9093a4;
}

.filer-progress trough {
    background-color: #eff1f5;
    border-radius: 2px;
    min-height: 5px;
    min-width: 90px;
}

.filer-progress progress {
    background-color: #1e66f5;
    border-radius: 2px;
    min-height: 5px;
}

/* ── Popovers & Menus ────────────────────────────────────────────────────── */
popover.menu > contents,
popover > contents {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #1e66f5;
    border-radius: 6px;
    padding: 4px;
}

popover.menu modelbutton:hover {
    background-color: #ccd0da;
    color: #bcc0cc;
    border-radius: 4px;
}
