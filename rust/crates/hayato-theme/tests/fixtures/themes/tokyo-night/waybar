/* Hayato theme: Tokyo Night (tokyo-night) - generated by `hayato theme set`; do not edit.
   Change the theme (`hayato theme set NAME`) or the template, then set it again. */
/* The bar is the session's statusline, not a shelf of widget cards.

   Hayato is a terminal-first desktop, so its bar follows the same grammar as
   every framework window: one continuous line, a rule under it, and colour
   that means a state instead of decorating an icon. A module is a segment of
   that line (flat, evenly padded, one hover fill). The brand sits at the left
   end with its cursor in the accent, the current workspace is a filled chip,
   and the busy and mode chips shout; nothing else is filled. A state word uses
   `*_text`, the readable form of a status colour; a switch changes its glyph,
   not its colour, except the keep-awake cup, which takes the accent while it
   is on.

   The palette comes from the active theme (spec 004) - this file is generated. */
* {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: background-color 120ms ease, color 120ms ease;
}

/* The bar is a layer-shell surface with alpha < 1 so that swayfx can blur the
   wallpaper behind it (layer_effects "waybar" in
   /etc/sway/config.d/26-swayfx.conf). The bar floats: `config.jsonc` insets it
   by 6px at the top and 12px on both sides - the same left/right inset as the
   windows under it - and this rule rounds it. The border is the
   bar's own background colour, so the panel reads as one solid object with no
   edge drawn around it; it stays 1px so the geometry does not change when the
   colour does. The alpha keeps `text` readable over any wallpaper. */
window#waybar {
    background: rgba(26, 27, 38, 0.88);
    color: #c0caf5;
    border: 1px solid rgba(26, 27, 38, 0.88);
    border-radius: 3px;
}

/* A 4px inset at both ends, so the first glyph and the last value never sit
   against the edge of the screen. */
.modules-left {
    margin-left: 4px;
}

.modules-right {
    margin-right: 4px;
}

/* Cyber-HUD terminal tooltips matching hayato-notify's 3px left accent rail,
   3px corners, and monospace telemetry grammar across all 16 themes. */
tooltip,
tooltip.background {
    background: rgba(31, 35, 53, 0.96);
    color: #c0caf5;
    border: 1px solid rgba(122, 162, 247, 0.90);
    border-left: 3px solid #7aa2f7;
    border-radius: 3px;
    padding: 8px 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
}

tooltip decoration {
    background: transparent;
    border: none;
    box-shadow: none;
}

tooltip > box {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

tooltip label {
    color: #c0caf5;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 500;
    padding: 0;
    margin: 0;
}

/* A segment: no card, no outline, the same padding for a built-in module and
   for one of the bar-* scripts. `text` is the reading colour and clears 4.5:1
   on the background in every built-in theme; `strong` is not used as a text
   colour here because it is the *bright* end of the palette, which on a light
   theme (Catppuccin Latte) is the colour of the background. Emphasis is
   weight. */
#custom-busy,
#privacy,
#custom-updates,
#tray,
#custom-keyboard-layout,
#custom-bluetooth,
#custom-vnc,
#custom-drives,
#network,
#pulseaudio,
#backlight,
#idle_inhibitor,
#battery {
    margin: 0;
    padding: 0 9px;
    background: transparent;
    border: none;
    border-radius: 0;
    color: #c0caf5;
}

/* The brand, at the left end: the mark (`z_`, the lazy z and its cursor, the
   shape of brand/hayato.svg) with no pill - the `z` is the reading colour and
   the `_` cursor is the accent, the same accent as the current workspace chip.
   The word is split across two modules only so the cursor can carry a colour
   of its own; both halves are the menu button. */
#custom-brand {
    margin: 4px 0 4px 4px;
    padding: 0 0 0 9px;
    color: #c0caf5;
    font-weight: 700;
}

#custom-brand-dot {
    margin: 4px 6px 4px 0;
    padding: 0 9px 0 0;
    color: #7aa2f7;
    font-weight: 700;
}

/* The line is monochrome: an indicator is the reading colour, and the state is
   the picture. Bluetooth, wifi and the volume share one pattern from the
   Material Design Icons font the image already ships: the icon while the thing
   is on, the same icon with a slash through it while it is off
   (`f00af`/`f00b2`, `f05a9`/`f05aa`, `f057e`/`f0581`). The keep-awake cup is
   the one switch with a single picture, so it says its state in colour: `dim`
   while the screen may sleep (the usual case), the accent while it is holding
   the screen awake. That accent, the brand's cursor and the current workspace
   chip are the only colour on the line; nothing else changes hue. */

/* The keep-awake cup, both states of the one glyph: `dim` is the resting state,
   the accent (the current workspace's colour) is the promise. The tooltip says
   it in words too. */
#idle_inhibitor.deactivated {
    color: #7a819e;
}

#idle_inhibitor.activated {
    color: #7aa2f7;
}

/* The battery has no rule of its own: an icon at every charge, in the reading
   colour. The charge is a tooltip, like every other reading on the line, and
   only charging changes the picture (a bolt). */

/* No hover fill: pointing at an indicator must not light it up. The tooltip
   is the feedback, and the click does what the tooltip says. */

/* Work in progress is the one filled chip on the line, so the spinner and the
   task it names are the first thing the eye finds. The fill is the *readable*
   warning colour and the label is the background, a pair that clears 4.5:1 on
   every built-in theme; the plain `warn` would leave the label at 3.5:1 on a
   light one. It is also the stop button. */
#custom-busy {
    margin: 4px 4px 4px 0;
    padding: 0 8px;
    background: #e0af68;
    color: #1a1b26;
    font-weight: 700;
}

/* The StatusNotifier icons keep their own colours; only the slot is themed. */
#tray {
    padding: 0 8px;
    color: #c0caf5;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background: #422b39;
    border-left: 2px solid #f7768e;
}

/* A module whose script reports nothing (no upgrades, a single keyboard
   layout) collapses to zero width instead of leaving an empty segment on the
   bar.  The class comes from the JSON the script prints. */
#privacy-item.screenshare {
    color: #f7768e;
}

#privacy-item.audio-in {
    color: #e0af68;
}

#custom-updates.empty,
#custom-busy.empty,
#custom-keyboard-layout.empty,
#custom-vnc.empty,
#custom-drives.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

/* Remote control is the explicit second start (`--disable-input` absent), and
   the tooltip is the word. The state is a 2px bar in `danger`, never a hue on
   the glyph: a switch changes its glyph, not its colour. */
#custom-vnc.control {
    box-shadow: inset 0 -2px 0 #f7768e;
}

/* The clock is the anchor of the line: the only larger text on the bar, bold
   and in `text`, so it reads on a light theme too. */
#clock {
    color: #c0caf5;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
}

/* Workspaces are the session's tabs, drawn the way the mockup draws them: a
   number, and the current one in a filled rounded chip with the background's
   colour as its label (the same pair the busy chip uses, which clears 4.5:1
   in every built-in theme). The chip is the only fill on the left end. */
#workspaces {
    margin: 4px 2px;
    padding: 0;
}

#workspaces button {
    min-width: 22px;
    padding: 0 9px;
    margin: 0 2px;
    background: transparent;
    color: #c0caf5;
    border: none;
    border-radius: 5px;
    box-shadow: none;
}

#workspaces button.focused,
#workspaces button.active {
    background: #7aa2f7;
    color: #1a1b26;
    border-radius: 5px;
    box-shadow: none;
}

/* Urgency on a tab that is not the current one: the label takes
   `danger_text`. The current tab keeps its fill, because the fill is where
   you are. */
#workspaces button.urgent:not(.focused):not(.active) {
    color: #f7768e;
    font-weight: 700;
}

#workspaces button label {
    font-size: 13px;
    font-weight: 500;
}

#workspaces button.focused label,
#workspaces button.active label,
#workspaces button.urgent label {
    font-weight: 700;
}

/* A mode (resize, move) is a filled chip in the readable warning colour, the
   second and last thing on the bar that is allowed to shout. */
#mode {
    margin: 4px 0;
    padding: 0 9px;
    color: #1a1b26;
    background: #e0af68;
    border: 1px solid #e0af68;
    border-radius: 0;
    font-weight: 700;
}
