/* Hayato theme: Matte Black (matte-black) - generated by `hayato theme set`; do not edit.
   Change the theme (`hayato theme set NAME`) or the template, then set it again. */
/* Hayato Filer: minimalistic Finder / elementary OS Files layout with Hayato
 * Cyber-HUD geometry and live theme tokens.
 *
 * This file is generated; edit rust/crates/hayato-theme/templates/filer.css.tpl.
 */

window.hayato-filer {
    background-color: #0e0e10;
    color: #e4e4e7;
    font-size: 13px;
}

/* ── Top Header & Breadcrumbs ────────────────────────────────────────────── */
.filer-header {
    background-color: #18181b;
    border-bottom: 1px solid #a1a1aa;
    padding: 4px 8px;
    min-height: 36px;
}

.filer-nav-btn,
.filer-tool-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #e4e4e7;
    padding: 4px 8px;
    min-height: 24px;
    min-width: 24px;
    box-shadow: none;
}

.filer-nav-btn:hover,
.filer-tool-btn:hover {
    background-color: #52525b;
    border-color: #a1a1aa;
}

.filer-nav-btn:disabled {
    color: #646466;
}

.filer-tool-btn.active {
    background-color: #27272a;
    border-color: #a1a1aa;
    color: #ffffff;
}

.filer-breadcrumbs {
    background-color: #0e0e10;
    border: 1px solid #a1a1aa;
    border-radius: 5px;
    padding: 2px 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

.filer-crumb {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #8a8a8d;
    padding: 2px 6px;
    min-height: 20px;
    box-shadow: none;
}

.filer-crumb:hover {
    background-color: #52525b;
    color: #ffffff;
}

.filer-crumb.current {
    color: #ffffff;
    font-weight: 700;
}

.filer-crumb-sep {
    color: #646466;
    padding: 0 2px;
}

.filer-path-entry,
.filer-filter-entry {
    background-color: #0e0e10;
    color: #ffffff;
    border: 1px solid #a1a1aa;
    border-radius: 5px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    min-height: 24px;
}

/* ── Left Sidebar (Places & Devices) ─────────────────────────────────────── */
.filer-sidebar {
    background-color: #18181b;
    border-right: 1px solid #a1a1aa;
    padding: 8px 6px;
}

.filer-section-label {
    color: #8a8a8d;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 8px 4px 8px;
}

.filer-place-row {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px 8px;
    margin: 1px 0;
    color: #e4e4e7;
}

.filer-place-row:hover {
    background-color: #52525b;
}

.filer-place-row.active {
    background-color: #27272a;
    border-left: 2px solid #a1a1aa;
    color: #ffffff;
    font-weight: 600;
}

.filer-badge {
    background-color: #52525b;
    color: #8a8a8d;
    border-radius: 8px;
    padding: 1px 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
}

.filer-dev-action {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #8a8a8d;
    padding: 1px 5px;
    min-height: 18px;
    min-width: 18px;
    box-shadow: none;
}

.filer-dev-action:hover {
    background-color: #0e0e10;
    border-color: #a1a1aa;
    color: #a1a1aa;
}

.filer-usage-bar trough {
    background-color: #0e0e10;
    border-radius: 2px;
    min-height: 3px;
}

.filer-usage-bar progress {
    background-color: #a1a1aa;
    border-radius: 2px;
    min-height: 3px;
}

/* ── Main Canvas (Grid & List Views) ─────────────────────────────────────── */
.filer-canvas {
    background-color: #0e0e10;
    color: #e4e4e7;
}

.filer-grid-item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 6px;
    margin: 3px;
}

.filer-grid-item:hover {
    background-color: #18181b;
    border-color: #a1a1aa;
}

.filer-grid-item.selected {
    background-color: #27272a;
    border-color: #a1a1aa;
}

.filer-list-row {
    background: transparent;
    border-left: 2px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 1px 4px;
}

.filer-list-row:hover {
    background-color: #18181b;
}

.filer-list-row.selected {
    background-color: #27272a;
    border-left-color: #a1a1aa;
}

.filer-item-name {
    color: #e4e4e7;
}

.filer-item-name.dir {
    color: #ffffff;
    font-weight: 600;
}

.filer-item-meta {
    color: #8a8a8d;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

/* ── Drag & Drop Highlighting ────────────────────────────────────────────── */
.drop-hover {
    background-color: #27272a;
    border: 1px dashed #a1a1aa;
    border-radius: 6px;
}

.drop-hover-trash {
    background-color: #52525b;
    border: 1px dashed #eab308;
    border-radius: 6px;
}

/* ── Quick Look Overlay & Banners ────────────────────────────────────────── */
.filer-quicklook {
    background-color: #18181b;
    border: 1px solid #a1a1aa;
    border-radius: 8px;
    padding: 14px;
}

.filer-quicklook-title {
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
}

.filer-quicklook-text {
    background-color: #0e0e10;
    color: #e4e4e7;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    border: 1px solid #a1a1aa;
    border-radius: 4px;
    padding: 8px;
}

.filer-banner {
    background-color: #52525b;
    border-bottom: 1px solid #a1a1aa;
    padding: 5px 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

.filer-banner.warn {
    color: #eab308;
}

.filer-banner.danger {
    color: #ef4444;
}

.filer-banner.ok {
    color: #22c55e;
}

/* ── Bottom Monospace HUD Status Bar ─────────────────────────────────────── */
.filer-statusbar {
    background-color: #18181b;
    border-top: 1px solid #a1a1aa;
    padding: 3px 10px;
    min-height: 24px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #8a8a8d;
}

.filer-progress trough {
    background-color: #0e0e10;
    border-radius: 2px;
    min-height: 5px;
    min-width: 90px;
}

.filer-progress progress {
    background-color: #a1a1aa;
    border-radius: 2px;
    min-height: 5px;
}

/* ── Popovers & Menus ────────────────────────────────────────────────────── */
popover.menu > contents,
popover > contents {
    background-color: #18181b;
    color: #e4e4e7;
    border: 1px solid #a1a1aa;
    border-radius: 6px;
    padding: 4px;
}

popover.menu modelbutton:hover {
    background-color: #27272a;
    color: #ffffff;
    border-radius: 4px;
}
