  --border: #82fb9c;
  --faint: #5f6a73;
  --dim: #85949d;
  --text: #ddf7ff;
  --strong: #ffffff;
  --accent: #82fb9c;
  --accent-alt: #57c7ff;
  --ok: #82fb9c;
  --warn: #f3f99d;
