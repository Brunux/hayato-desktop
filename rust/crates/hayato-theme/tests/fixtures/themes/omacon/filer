/* Hayato theme: Omacon (omacon) - generated by `hayato theme set`; do not edit.
   Change the theme (`hayato theme set NAME`) or the template, then set it again. */
/* Hayato Filer: minimalistic Finder / elementary OS Files layout with Hayato
 * Cyber-HUD geometry, vector Font Awesome icons, and live theme tokens.
 *
 * This file is generated; edit rust/crates/hayato-theme/templates/filer.css.tpl.
 */

window.hayato-filer {
    background-color: #130c2b;
    color: #f5caff;
    font-size: 13px;
}

window.hayato-filer button {
    background-image: none;
    box-shadow: none;
    outline: none;
}

window.hayato-filer paned > separator {
    background-color: #ff66ff;
    min-width: 1px;
}

/* ── Vector Font Awesome Icons & Semantic Theme Tints ────────────────────── */
.filer-glyph,
.filer-place-icon,
.filer-menu-icon,
.filer-grid-glyph,
.filer-list-glyph,
.filer-ql-glyph,
.filer-empty-glyph {
    font-family: "FontAwesome", "Font Awesome 6 Free Solid", sans-serif;
}

.filer-glyph {
    font-size: 13px;
}

.filer-place-icon {
    font-size: 13px;
    color: #967aa6;
}

.filer-place-row.active .filer-place-icon,
.filer-device-card.active .filer-place-icon {
    color: #ff66ff;
}

.filer-grid-glyph {
    font-size: 36px;
}

.filer-list-glyph {
    font-size: 15px;
}

.filer-ql-glyph {
    font-size: 56px;
}

.filer-empty-glyph {
    font-size: 44px;
    color: #6d5880;
}

.icon-folder  { color: #ff66ff; }
.icon-image   { color: #a64dff; }
.icon-audio   { color: #00ffaa; }
.icon-video   { color: #a64dff; }
.icon-pdf     { color: #ff5588; }
.icon-archive { color: #ffd700; }
.icon-code    { color: #a64dff; }
.icon-exec    { color: #00ffaa; }
.icon-file    { color: #967aa6; }

/* ── Top Header, Segmented Controls & Breadcrumbs ────────────────────────── */
.filer-header {
    background-color: #20153f;
    border-bottom: 1px solid #ff66ff;
    padding: 6px 10px;
    min-height: 40px;
}

.filer-seg-group {
    background-color: #130c2b;
    border: 1px solid #ff66ff;
    border-radius: 6px;
    padding: 2px;
}

.filer-nav-btn,
.filer-tool-btn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #f5caff;
    padding: 3px 8px;
    min-height: 24px;
    min-width: 26px;
}

.filer-nav-btn:hover,
.filer-tool-btn:hover {
    background-color: #452c80;
    color: #ffffff;
}

.filer-nav-btn:disabled {
    color: #6d5880;
}

.filer-tool-btn.active {
    background-color: #3a2266;
    border-color: #ff66ff;
    color: #ffffff;
}

.filer-breadcrumbs {
    background-color: #130c2b;
    border: 1px solid #ff66ff;
    border-radius: 6px;
    padding: 2px 6px;
    min-height: 28px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

.filer-crumb {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #967aa6;
    padding: 2px 6px;
    min-height: 22px;
}

.filer-crumb:hover {
    background-color: #452c80;
    color: #ffffff;
}

.filer-crumb.current {
    color: #ffffff;
    font-weight: 700;
}

.filer-crumb-sep {
    color: #6d5880;
    padding: 0 2px;
}

.filer-path-entry,
.filer-filter-entry {
    background-color: #130c2b;
    color: #ffffff;
    border: 1px solid #ff66ff;
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    min-height: 26px;
}

/* ── Left Sidebar (Places & Devices) ─────────────────────────────────────── */
.filer-sidebar {
    background-color: #20153f;
    padding: 8px 6px;
}

.filer-section-label {
    color: #967aa6;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 10px 8px 4px 8px;
}

.filer-place-row {
    background-color: transparent;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: 5px;
    padding: 5px 8px;
    margin: 1px 0;
    color: #f5caff;
}

.filer-place-row:hover {
    background-color: #452c80;
    color: #ffffff;
}

.filer-place-row.active {
    background-color: #3a2266;
    border-left-color: #ff66ff;
    color: #ffffff;
    font-weight: 600;
}

.filer-device-card {
    background-color: transparent;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: 5px;
    padding: 4px 6px;
    margin: 2px 0;
}

.filer-device-card:hover {
    background-color: #452c80;
}

.filer-device-card.active {
    background-color: #3a2266;
    border-left-color: #ff66ff;
}

.filer-device-btn {
    background-color: transparent;
    border: none;
    padding: 2px 4px;
    color: #f5caff;
}

.filer-badge {
    background-color: #452c80;
    color: #967aa6;
    border-radius: 8px;
    padding: 1px 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
}

.filer-dev-action {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #967aa6;
    padding: 2px 6px;
    min-height: 20px;
    min-width: 22px;
}

.filer-dev-action:hover {
    background-color: #130c2b;
    border-color: #ff66ff;
    color: #ff66ff;
}

.filer-usage-bar trough {
    background-color: #130c2b;
    border-radius: 2px;
    min-height: 3px;
}

.filer-usage-bar progress {
    background-color: #ff66ff;
    border-radius: 2px;
    min-height: 3px;
}

/* ── Main Canvas (Grid & List Views) ─────────────────────────────────────── */
.filer-canvas {
    background-color: #130c2b;
    color: #f5caff;
}

flowboxchild {
    background: transparent;
    padding: 0;
    border-radius: 8px;
    outline: none;
}

flowboxchild:selected {
    background: transparent;
}

.filer-grid-item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 6px;
    margin: 2px;
}

.filer-grid-item:hover {
    background-color: #20153f;
    border-color: #ff66ff;
}

flowboxchild:selected .filer-grid-item {
    background-color: #3a2266;
    border-color: #ff66ff;
}

.filer-thumb {
    border-radius: 6px;
    border: 1px solid #ff66ff;
    background-color: #20153f;
    overflow: hidden;
}

/* Sticky List View Column Header */
.filer-list-header {
    background-color: #20153f;
    border-bottom: 1px solid #ff66ff;
    padding: 3px 12px;
}

.filer-col-btn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px 4px;
    color: #967aa6;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

.filer-col-btn:hover,
.filer-col-btn.active {
    color: #ffffff;
}

list > row {
    background: transparent;
    padding: 0;
    outline: none;
}

list > row:selected {
    background: transparent;
}

.filer-list-row {
    background-color: transparent;
    border-left: 2px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
    margin: 1px 6px;
}

.filer-list-row:hover {
    background-color: #20153f;
}

list > row:selected .filer-list-row {
    background-color: #3a2266;
    border-left-color: #ff66ff;
}

.filer-item-name {
    color: #f5caff;
    font-size: 12px;
}

.filer-item-name.dir {
    color: #ffffff;
    font-weight: 600;
}

.filer-item-meta {
    color: #967aa6;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

/* ── Empty State ─────────────────────────────────────────────────────────── */
.filer-empty-state {
    padding: 32px;
}

.filer-empty-title {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

.filer-empty-sub {
    color: #967aa6;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

/* ── Drag & Drop Highlighting ────────────────────────────────────────────── */
.drop-hover {
    background-color: #3a2266;
    border: 1px dashed #ff66ff;
    border-radius: 6px;
}

.drop-hover-trash {
    background-color: #452c80;
    border: 1px dashed #ffd700;
    border-radius: 6px;
}

/* ── Quick Look Overlay & Banners ────────────────────────────────────────── */
.filer-quicklook {
    background-color: #20153f;
    border: 1px solid #ff66ff;
    border-radius: 10px;
    padding: 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
}

.filer-quicklook-title {
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
}

.filer-quicklook-text {
    background-color: #130c2b;
    color: #f5caff;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    border: 1px solid #ff66ff;
    border-radius: 6px;
    padding: 8px;
}

.filer-banner {
    background-color: #452c80;
    border-bottom: 1px solid #ff66ff;
    padding: 5px 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

.filer-banner.warn {
    color: #ffd700;
}

.filer-banner.danger {
    color: #ff5588;
}

.filer-banner.ok {
    color: #00ffaa;
}

/* ── Bottom Monospace HUD Status Bar ─────────────────────────────────────── */
.filer-statusbar {
    background-color: #20153f;
    border-top: 1px solid #ff66ff;
    padding: 4px 12px;
    min-height: 26px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #967aa6;
}

.filer-progress trough {
    background-color: #130c2b;
    border-radius: 2px;
    min-height: 5px;
    min-width: 90px;
}

.filer-progress progress {
    background-color: #ff66ff;
    border-radius: 2px;
    min-height: 5px;
}

/* ── Popovers & Finder-Style Context Menus ───────────────────────────────── */
popover > contents {
    background-color: #20153f;
    color: #f5caff;
    border: 1px solid #ff66ff;
    border-radius: 8px;
    padding: 6px;
    min-width: 215px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}

.filer-menu-item {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f5caff;
}

.filer-menu-item:hover {
    background-color: #3a2266;
    color: #ffffff;
}

.filer-menu-item.danger {
    color: #ff5588;
}

.filer-menu-icon {
    font-size: 12px;
    color: #967aa6;
}

.filer-menu-item:hover .filer-menu-icon {
    color: #ff66ff;
}

.filer-menu-item.danger .filer-menu-icon {
    color: #ff5588;
}

.filer-menu-shortcut {
    color: #967aa6;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
}

.filer-menu-sep {
    background-color: #ff66ff;
    min-height: 1px;
    margin: 4px 2px;
}
