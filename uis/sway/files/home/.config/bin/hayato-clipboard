#!/bin/sh
# Clipboard history: one watcher, and one place that says whether it should run.
#
#   hayato-clipboard start    start the watcher if ~/.config/hayato/clipboard.conf says yes
#   hayato-clipboard stop     stop the watcher
#   hayato-clipboard restart  stop, then start
#   hayato-clipboard status   "enabled=yes running=yes" (or no)
#
# The system config used to run `wl-paste --watch cliphist store` directly, so
# turning history off meant editing /etc. This helper is the user-level switch:
# Settings writes `enabled=yes|no` and restarts it. The watcher is wl-paste's
# own, not a polling daemon; stopping it leaves the existing database intact.

set -eu

conf=${XDG_CONFIG_HOME:-$HOME/.config}/hayato/clipboard.conf
enabled=yes
# Anchored on purpose. Sway starts this helper from a `sh -c` line that itself
# contains "wl-paste --watch cliphist store"; an unanchored `pgrep -f` matches
# that parent, concludes the watcher is already up, and never starts it - which
# is why the v0.6.0 first boot had no clipboard history until it was started by
# hand. `^...$` matches the watcher's own argv and nothing else.
watcher='^wl-paste --watch cliphist store$'

read_config() {
	[ -r "$conf" ] || return 0
	while IFS='=' read -r _key _value; do
		case $_key in
		enabled)
			case $_value in
			yes | no) enabled=$_value ;;
			esac
			;;
		esac
	done <"$conf"
}

running() {
	pgrep -f "$watcher" >/dev/null 2>&1
}

stop_watcher() {
	pkill -f "$watcher" >/dev/null 2>&1 || true
}

start_watcher() {
	read_config
	[ "$enabled" = yes ] || return 0
	running && return 0
	# The watcher's own words go to a file, not /dev/null: a session that
	# starts before the compositor's socket is reachable leaves wl-paste with
	# nothing to connect to, and without this line the next boot can only say
	# "not running". One retry covers that race.
	_log="${XDG_STATE_HOME:-$HOME/.local/state}/hayato/clipboard.log"
	mkdir -p "${_log%/*}" 2>/dev/null || :
	setsid wl-paste --watch cliphist store >>"$_log" 2>&1 &
	_i=0
	while [ "$_i" -lt 20 ] && ! running; do
		sleep 0.1
		_i=$((_i + 1))
	done
	if ! running; then
		printf '%s start: wl-paste exited, retrying\n' "$(date '+%F %T')" >>"$_log"
		setsid wl-paste --watch cliphist store >>"$_log" 2>&1 &
	fi
}

case ${1:-} in
start)
	read_config
	[ "$enabled" = yes ] || { stop_watcher; exit 0; }
	start_watcher
	;;
stop) stop_watcher ;;
restart)
	stop_watcher
	start_watcher
	;;
status)
	read_config
	if running; then
		printf 'enabled=%s running=yes\n' "$enabled"
	else
		printf 'enabled=%s running=no\n' "$enabled"
	fi
	;;
*)
	echo "usage: hayato-clipboard start|stop|restart|status" >&2
	exit 2
	;;
esac
