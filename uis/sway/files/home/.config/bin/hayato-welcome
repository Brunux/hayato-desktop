#!/bin/sh
# The first boot's welcome window: one foot, once per install.
#
# The marker holds the machine id the window was last shown for, so the
# condition is "this install has not seen it" and not "this home has not": a
# rebuilt card (and install-emmc.sh's copy) gets a fresh /etc/machine-id, and a
# home carried over from another install is not a reason to skip it.  A session
# restart is not a new install either, so the marker is written after the window
# closes, not when it opens.
#
# `--print` outputs the plain-ASCII Mission Briefing summary (used as the
# fallback pager when `hayato` is absent and checked by `check-desktop.sh`).

set -eu

marker_dir=${XDG_STATE_HOME:-$HOME/.local/state}/hayato
marker=$marker_dir/welcome

print_text() {
	cat <<'EOF'
 _   _                  _
| | | | __ _ _   _ __ _| |_ ___
| |_| |/ _` | | | / _` | __/ _ \
|  _  | (_| | |_| | (_| | || (_) |  _
|_| |_|\__,_|\__, |\__,_|\__\___/  (_)
             |___/   :: light. fast. fun. ::

Welcome to Hayato -- Keyboard-first · Zero bloat · Local AI · Yours

Essential keys:
  Alt+Space         root menu: apps, studios, settings, power
  Search / Alt+D    app launcher: type part of a name, Enter opens it
  Alt+Ctrl+F        browse files, one directory per step
  Alt+Ctrl+T        translate selected text (online or Local AI)
  Alt+Return        open a foot terminal
  Alt+Q             close the focused window
  Alt+Escape        power menu: lock, suspend, log out, reboot, shut down
  Alt+Ctrl+K        every key binding, generated live from Sway

Studios & tools:
  Hayato Lens       Alt+I -- local Circle-to-Search (OCR, QR, URLs)
  Hayato Drop       LAN nearby file share via scannable QR code
  Local AI          offline Qwen3.5-0.8B Ask & Translate with zero cloud
  Smart Clipboard   Alt+Ctrl+V -- history by kind, Ctrl+T URL clean / JSON
  Eject Drive       safe USB / SD unmount & power-off from Places
  Mic Privacy       Alt+Shift+M -- instant microphone mute toggle

The manual is under Learn in the menu (`hayato menu learn`), or in
/usr/share/doc/hayato/.  Reopen the interactive briefing anytime with
`hayato menu welcome`.

Enter closes this window - it appears once per install.
EOF
}

case ${1:-} in
--print)
	print_text
	exit 0
	;;
esac

# A window with no machine id cannot be remembered, and showing it on every
# login would be worse than not showing it at all.
machine_id=$(cat /etc/machine-id 2>/dev/null || true)
[ -n "$machine_id" ] || exit 0
if [ -f "$marker" ] && [ "$(cat "$marker" 2>/dev/null || true)" = "$machine_id" ]; then
	exit 0
fi

# foot is the session's terminal; without it there is no window to show, and
# the marker stays absent so the next login tries again.
command -v foot >/dev/null 2>&1 || exit 0

mkdir -p "$marker_dir"
# Launch the interactive Ratatui Mission Briefing (`hayato menu welcome`),
# falling back to the plain-ASCII pager if `hayato` is not yet installed.
if foot --app-id=hayato-welcome --title='Welcome to Hayato' \
	-e sh -c 'if command -v hayato >/dev/null 2>&1; then exec hayato menu welcome; else "$0" --print; read -r _ || true; fi' "$0"; then
	printf '%s\n' "$machine_id" >"$marker"
fi
