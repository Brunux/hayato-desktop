#!/bin/sh
# Idle and lock: one swayidle chain whose three timeouts are a setting.
#
#   lazyos-idle start     start (or reload) the chain from ~/.config/lazyos/idle.conf
#   lazyos-idle restart   stop the old chain, then start
#   lazyos-idle stop      stop the chain
#   lazyos-idle status    machine-readable timeouts: screen_off= lock= dpms=
#
# The system config starts swayidle with 150/300/360 s. This helper is the
# user-level override: the Settings row writes ~/.config/lazyos/idle.conf and
# then runs `restart`. It kills only `swayidle`, starts one detached chain, and
# leaves the screensaver/lock helpers exactly as before.
#
# A time of 0 means "never" and omits that timeout. The three are kept in
# order: screen off, lock, panel off. DPMS after lock, or the panel would go
# dark while the lock is still drawing.

set -eu

config=${XDG_CONFIG_HOME:-$HOME/.config}/lazyos/idle.conf
screen_off=150
lock=300
dpms=360

read_config() {
	[ -r "$config" ] || return 0
	while IFS='=' read -r _key _value; do
		case $_key in
		screen_off) screen_off=$_value ;;
		lock) lock=$_value ;;
		dpms) dpms=$_value ;;
		esac
	done <"$config"
}

number_or() { # $1 value, $2 fallback
	case ${1:-} in
	'' | *[!0-9]*) printf '%s' "$2" ;;
	*) printf '%s' "$1" ;;
	esac
}

stop_chain() {
	pkill -x swayidle >/dev/null 2>&1 || true
	_i=0
	while pgrep -x swayidle >/dev/null 2>&1; do
		_i=$((_i + 1))
		[ "$_i" -ge 20 ] && break
		sleep 0.1
	done
}

start_chain() {
	read_config
	screen_off=$(number_or "$screen_off" 150)
	lock=$(number_or "$lock" 300)
	dpms=$(number_or "$dpms" 360)

	set -- -w
	[ "$screen_off" -gt 0 ] &&
		set -- "$@" timeout "$screen_off" "$HOME/.config/bin/lazyos-screensaver"
	[ "$lock" -gt 0 ] &&
		set -- "$@" timeout "$lock" "$HOME/.config/bin/sway-lock"
	[ "$dpms" -gt 0 ] &&
		set -- "$@" timeout "$dpms" 'swaymsg "output * power off"'
	set -- "$@" resume 'swaymsg "output * power on"'
	set -- "$@" before-sleep "$HOME/.config/bin/sway-lock --wait"
	set -- "$@" after-resume \
		"pkill -f '[o]rg.lazyos.screensaver'; swaymsg 'output * power on'; $HOME/.config/bin/night-light resume; [ -x /usr/local/bin/lazyos-dp-resume ] && /usr/local/bin/lazyos-dp-resume || true"

	setsid swayidle "$@" >/dev/null 2>&1 &
}

case ${1:-} in
start | restart)
	stop_chain
	start_chain
	;;
stop) stop_chain ;;
status)
	read_config
	printf 'screen_off=%s lock=%s dpms=%s\n' \
		"$(number_or "$screen_off" 150)" \
		"$(number_or "$lock" 300)" \
		"$(number_or "$dpms" 360)"
	;;
*)
	echo "usage: lazyos-idle start|restart|stop|status" >&2
	exit 2
	;;
esac
