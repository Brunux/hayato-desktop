// The session's statusline. It spans the screen edge to edge with no gaps, so
// it reads as one line rather than a shelf of floating cards; style.css owns
// what each segment looks like.
//
// Every pointer interaction that Deboma (Omarchy) answers with a panel is answered here
// with a short-lived menu popup from ~/.config/bin/bar-*, and nothing stays
// resident: the bar itself is the only process this file keeps alive.  Icons
// are written as \uXXXX so the codepoints are readable and survive any editor;
// they come from fonts-font-awesome-legacy (see uis/sway/README.md).
//
// Clicks:
//   busy        left: stop the task the spinner names   (see bar-busy)
//   menu        left: root menu   right: terminal
//   clock       left: switch format (time/seconds)   scroll: calendar months
//   updates     left: open the updater (only visible when something is pending)
//   tray        the StatusNotifier items of running applications
//   layout      left: next xkb layout (hidden with a single layout)
//   bluetooth   left: device list  right: bluetoothctl in a floating terminal
//   network     left: Wi-Fi list   right: nmtui in a floating terminal
//   volume      left: mute  right: output list  scroll: volume
//   brightness  scroll: backlight
//   battery     left: power panel  right: root menu
{
    "layer": "top",
    "position": "top",
    "height": 34,
    // No gap between modules; the bar itself floats: 6px from the top and 12px
    // from both sides, with the rounded corners style.css draws, so it reads as
    // a panel over the desktop instead of a strip welded to the edge. The 12px
    // is the session's window inset (gaps outer 4 + inner 8 in
    // 90-desktop.conf), so the panel's sides line up with the windows under
    // it. The 4px at each end is a separate margin inside style.css.
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "custom/brand",
        "custom/brand-dot",
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/busy",
        "custom/keyboard-layout",
        "custom/vnc",
        "custom/bluetooth",
        "network",
        "pulseaudio",
        "backlight",
        "idle_inhibitor",
        "battery",
        "custom/updates",
        "tray"
    ],
    // The brand: the mark is a prompt (`z_`, the lazy z and its cursor - the
    // same shape as brand/hayato.svg), the `z` in the reading colour and the
    // `_` cursor in the accent - the same accent as the current workspace
    // chip. The word is split across two modules only so the cursor can carry
    // a colour of its own; style.css joins them and both halves are the menu
    // button.
    "custom/brand": {
        "format": "<span font_desc='JetBrains Mono 14' weight='bold'>z</span>",
        "tooltip": false,
        "on-click": "~/.config/bin/bar-menu",
        "on-click-right": "foot"
    },
    "custom/brand-dot": {
        "format": "<span font_desc='JetBrains Mono 14' weight='bold'>_</span>",
        "tooltip": false,
        "on-click": "~/.config/bin/bar-menu",
        "on-click-right": "foot"
    },
    // workspace icons: workstyle (tools/workstyle/) renames each workspace to
    // "3: <glyphs>", one per kind of window in it, and `{value}` is that whole
    // name - number included, so Alt+3 and the third pill still mean the same
    // thing, and a workspace with no window keeps its bare number. `{name}`
    // would drop the number (the module hands back only what is after the
    // colon) and `{icon}` would do the same.
    //
    // No persistent-workspaces on purpose: this module matches that list by
    // workspace *name*, and workstyle renames the workspaces, so every renamed
    // pill would come with a duplicate. (The "*": [1, 2, 3, 4, 5] shape this
    // file used to carry is the Hyprland module's format and drew nothing at
    // all here - a pill appears when its workspace exists.) `all-outputs`
    // stays for the day there is a second screen.
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{value}"
    },
    "sway/mode": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf11c</span>  {}",
        "tooltip": false
    },
    "clock": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf073</span>  {:%a, %d %b  %H:%M}",
        "format-alt": "<span font_desc='JetBrains Mono 13'>\uf073</span>  {:%H:%M:%S}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1
        },
        "interval": 30
    },
    // What busy is doing, as a spinner: only there while an action runs
    // (nmcli scanning or joining, bluetoothctl scanning, du measuring), so the
    // bar is unchanged in the common case.  One shell per second is the price
    // of the frame; the module prints {"class":"empty"} when idle and
    // style.css collapses it.
    //
    // The card is also the stop button (`bar-busy stop`): clicking it runs the
    // command the running task registered in BUSY_STOP, and the toast the card
    // belongs to becomes "Stopped <label>" instead of a second notification.
    // The tasks that can be stopped that way are the Wi-Fi scan and join, the
    // Bluetooth scan, the du walk of Free space and a dictation recording; the
    // ones that cannot (an apt install, the DNS re-activation, a radio switch,
    // a Bluetooth connect) say so when the card is clicked, because they are
    // either already over or not safe to cut.  The tooltip carries "click to
    // stop" only when there is something to run.
    "custom/busy": {
        "exec": "~/.config/bin/bar-busy",
        "return-type": "json",
        "interval": 1,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-busy stop"
    },
    "custom/updates": {
        "exec": "~/.config/bin/bar-updates",
        "return-type": "json",
        "interval": 21600,
        "signal": 8,
        "tooltip": true,
        "on-click": "hayato menu pkg"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "show-passive-items": true
    },
    // Screen sharing (Settings > Share this screen, and the root menu): an eye
    // while wayvnc serves this session read-only on the loopback address, and
    // nothing at all otherwise (style.css collapses .empty).  The module reads
    // the state file hayato-vnc keeps - one `sh` every ten seconds, no daemon -
    // and a start or a stop signals the bar (RTMIN+8), so the eye appears and
    // disappears at the moment it happens instead of on the next poll.  A right
    // click stops it: the one thing someone wants from an indicator that says
    // "you are being watched" is to be able to end it from the same place.
    "custom/vnc": {
        "exec": "~/.config/bin/hayato-vnc status --bar",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/hayato-vnc",
        "on-click-right": "~/.config/bin/hayato-vnc stop"
    },
    "custom/keyboard-layout": {
        "exec": "~/.config/bin/bar-key",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-key next",
        "on-click-right": "~/.config/bin/hayato-layout"
    },
    "custom/bluetooth": {
        "exec": "~/.config/bin/bar-bt status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/bin/bar-bt",
        "on-click-right": "foot --app-id=popup bluetoothctl"
    },
    "network": {
        // Waybar's built-in network module is the one indicator that cannot be
        // signalled: only `custom/*` modules listen for RTMIN+8, and this one
        // exposes nothing but `interval`. Its poll is a libiw ioctl and a read
        // of /proc/net/wireless - no process is spawned - so it runs every 3 s
        // instead: a radio toggle or a new association shows up almost at
        // once, and an external one (nmtui in a terminal) within the same
        // three seconds.
        "interval": 3,
        // The wifi pair is one picture in two states: the arcs while connected
        // (`f05a9`), the same arcs with a slash while offline (`f05aa`), both
        // from the Material Design Icons font the image ships. Bluetooth and
        // the volume follow the same pattern, so "off" always reads the same
        // way on this bar. No percentage rides beside them: the battery's
        // charge is a tooltip too. JSON's `\u` takes exactly four
        // hex digits, so a plane-15 glyph is written as a surrogate pair:
        // `\udb81\udda9` is U+F05A9, `\udb81\uddaa` is U+F05AA.
        "format-wifi": "<span font_desc='JetBrains Mono 13'>\udb81\udda9</span>",
        "format-ethernet": "<span font_desc='JetBrains Mono 13'>\uf233</span>",
        "format-linked": "<span font_desc='JetBrains Mono 13'>\uf1e6</span>",
        "format-disconnected": "<span font_desc='JetBrains Mono 13'>\udb81\uddaa</span>",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}\nGateway: {gwaddr}\nClick to pick a network",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}\nGateway: {gwaddr}",
        "on-click": "~/.config/bin/bar-net",
        "on-click-right": "foot --app-id=popup nmtui"
    },
    "pulseaudio": {
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>",
        // Mute is the speaker with the same slash the wifi and Bluetooth use
        // (`f0581` = `\udb81\udd81`), not a different "no" symbol; the three
        // levels are U+F057F/U+F0580/U+F057E.
        "format-muted": "<span font_desc='JetBrains Mono 13'>\udb81\udd81</span>",
        "format-icons": {
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
        "tooltip-format": "{desc} ({volume}%)",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "~/.config/bin/bar-audio",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
        "device": "backlight-lcd0",
        "format": "<span font_desc='JetBrains Mono 13'>\uf185</span>",
        "tooltip-format": "Brightness {percent}%",
        "interval": 5,
        "on-click": "~/.config/bin/hayato-display",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    // Keep the screen awake, on purpose, for the length of a film, a recipe or a
    // download watch.  This is waybar's own module: it holds a
    // zwp_idle_inhibitor_v1 on the bar's surface, so the session gains no helper
    // process and no script, and a click is the whole interface.  The cup is
    // always visible, because the control has to be visible to be turned on.
    // It is the one switch with a single picture, so it says its state in
    // colour instead: `dim` while the screen may sleep (the usual case), the
    // accent - the current workspace's colour - while it is holding the screen
    // awake; the two rules are in style.css, `#idle_inhibitor`.
    // `start-activated` stays false so a login never inherits it.
    //
    // Sway's own `inhibit_idle` is not what this uses: it has no `toggle` (only
    // focus|fullscreen|open|none|visible) and its user inhibitors belong to a
    // view, which would tie "keep awake" to a window.  The applications that
    // must not be interrupted are handled in config.d/32-idle-inhibit.conf, and
    // mpv asks for its own inhibitor.
    "idle_inhibitor": {
        "format": "<span font_desc='JetBrains Mono 13'>\uf0f4</span>",
        "tooltip-format-activated": "Keeping the screen awake\nClick to let it sleep",
        "tooltip-format-deactivated": "Click to keep the screen awake",
        "start-activated": false
    },
    "battery": {
        "bat": "sbs-8-000b",
        "states": {
            "warning": 30,
            "critical": 15
        },
        // The icon and nothing else: the charge is a tooltip, like every other
        // reading on the line, so the right end stays glyphs only. The bolt
        // (charging), the plug (plugged) and the full battery are the only
        // pictures that change; otherwise the five steps of `format-icons`.
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>",
        "format-charging": "<span font_desc='JetBrains Mono 13'>\uf0e7</span>",
        "format-plugged": "<span font_desc='JetBrains Mono 13'>\uf1e6</span>",
        "format-full": "<span font_desc='JetBrains Mono 13'>\uf240</span>",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "tooltip-format": "Battery {capacity}%\nClick for power menu",
        "interval": 30,
        "on-click": "~/.config/bin/bar-power",
        "on-click-right": "~/.config/bin/hayato-power"
    }
}
