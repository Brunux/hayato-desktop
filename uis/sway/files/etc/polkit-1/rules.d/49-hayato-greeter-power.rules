// Power controls in `hayato-greeter`: the console greeter runs as `_greetd` on
// VT7 and invokes `systemctl <suspend|reboot|poweroff> -i` when the operator
// confirms a power button on the login screen. Allow an active local greeter
// seat to complete those power actions cleanly without password prompts even if
// another session or inhibitor lock is active.
polkit.addRule(function (action, subject) {
    if (subject.user !== '_greetd' && subject.user !== 'greetd') {
        return;
    }
    if (!subject.local || !subject.active) {
        return;
    }
    if (action.id === 'org.freedesktop.login1.reboot' ||
        action.id === 'org.freedesktop.login1.reboot-multiple-sessions' ||
        action.id === 'org.freedesktop.login1.reboot-ignore-inhibit' ||
        action.id === 'org.freedesktop.login1.power-off' ||
        action.id === 'org.freedesktop.login1.power-off-multiple-sessions' ||
        action.id === 'org.freedesktop.login1.power-off-ignore-inhibit' ||
        action.id === 'org.freedesktop.login1.suspend' ||
        action.id === 'org.freedesktop.login1.suspend-multiple-sessions' ||
        action.id === 'org.freedesktop.login1.suspend-ignore-inhibit') {
        return polkit.Result.YES;
    }
});
